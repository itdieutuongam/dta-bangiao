# =============================================================================
# DTA Handover – biến môi trường cho phát triển cục bộ (npm run dev / preview)
#
#   cp .dev.vars.example .dev.vars        (PowerShell: Copy-Item .dev.vars.example .dev.vars)
#
# .dev.vars nằm trong .gitignore – KHÔNG commit file chứa giá trị thật.
# Production: dùng `npx wrangler secret put <TÊN_BIẾN>` (xem docs/CLOUDFLARE_DEPLOY.md).
# =============================================================================

# URL Web App của Google Apps Script (Deploy → Web app), dạng:
# https://script.google.com/macros/s/AKfycb.../exec
GAS_WEB_APP_URL=

# Chuỗi bí mật dùng chung giữa Worker và Apps Script để ký HMAC từng request.
# PHẢI trùng với Script Property BACKEND_SHARED_SECRET bên Apps Script.
# Tạo ngẫu nhiên (>= 32 ký tự), ví dụ:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GAS_SHARED_SECRET=

# Tài khoản quản trị — chọn MỘT trong hai cách:
# (1) Khuyến nghị: mỗi người một tài khoản (JSON 1 dòng, mật khẩu >= 12 ký tự, username a-z 0-9 . _ -).
#     Nhật ký ghi đúng người tạo / sửa / hủy phiếu, duyệt đề xuất, nhập kho, kiểm kê.
# ADMIN_USERS=[{"username":"thai","name":"Phạm Danh Thái","password":"doi-mat-khau-nay-123"}]
ADMIN_USERS=
# (2) Tương thích bản cũ: một mật khẩu dùng chung (chỉ dùng khi ADMIN_USERS trống).
ADMIN_PASSWORD=

# Khóa ký cookie phiên quản trị + sinh link xác nhận (>= 32 ký tự ngẫu nhiên).
# Lưu ý: đổi khóa này sẽ đăng xuất mọi phiên admin; link cũ vẫn dùng được
# nhưng admin cần bấm "Tạo link mới" nếu muốn sao chép lại link.
SESSION_SECRET=

# URL gốc dùng để tạo link xác nhận. Để trống = tự lấy theo domain đang truy cập
# (đúng cho cả `npm run dev` – http://localhost:5173 và `npm run preview` – http://localhost:4173).
# Dòng này ghi đè "APP_BASE_URL" trong wrangler.jsonc (production: https://bangiao.dieutuongam.com),
# nên khi chạy local hãy giữ dòng này (để trống) để link trỏ về máy local.
APP_BASE_URL=

# (Khuyến nghị) Mã truy cập nội bộ cho trang đề xuất văn phòng phẩm /de-xuat-vpp.
# Nếu đặt, nhân viên phải nhập mã này trước khi tra mã NV / gửi đề xuất. Để trống = không yêu cầu.
# (Tạo phiếu bàn giao luôn yêu cầu đăng nhập quản trị — không phụ thuộc biến này.)
STAFF_ACCESS_CODE=

# (Khuyến nghị) Khóa niêm phong biên bản đã ký (>= 32 ký tự ngẫu nhiên). Worker gửi khóa dẫn xuất kèm request; Apps Script dùng
# để niêm phong toàn bộ biên bản lúc ký (nội dung, ý kiến người nhận, thời điểm, chữ ký) — KHÔNG lưu ở Google, nên người sửa được
# Google Sheet không tự tính lại được niêm phong. Lưu giữ cẩn thận, KHÔNG đổi sau khi đã dùng (niêm phong cũ sẽ báo không khớp).
RECORD_SEAL_SECRET=
