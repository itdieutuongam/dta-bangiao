# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Cloudflare / Wrangler local state
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# Apps Script CLI (clasp) — chứa ID project/thông tin đăng nhập cục bộ
.clasp.json
.clasprc.json

# Cấu hình cục bộ của công cụ AI/IDE (quyền lệnh, đường dẫn máy cá nhân)
.claude/

# Logs
*.log
npm-debug.log*
logs/

# Test artifacts
test-results/
playwright-report/
.e2e/

# Tài liệu scan / PDF đặt nhầm ở thư mục gốc (có thể chứa dữ liệu nhạy cảm) — không bao giờ commit
/*.pdf

# Editor / OS
.DS_Store
Thumbs.db
.idea/
*.swp
